# THERMORA Environment Configuration
# VITE_USE_MOCK: Set to "true" to use built-in in-memory mock server, "false" to connect to real FastAPI backend.
VITE_USE_MOCK=true

# VITE_API_BASE_URL: Relative API prefix (default /api/v1). Kept relative so dev proxy and prod nginx avoid CORS.
VITE_API_BASE_URL=/api/v1

# VITE_PROXY_TARGET: Target URL for Vite dev proxy when forwarding /api requests.
VITE_PROXY_TARGET=http://localhost:8000
